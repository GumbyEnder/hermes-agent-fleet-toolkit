# Hermes Agent Fleet Toolkit — example config
#
#   cp config.example.env ~/.config/hermes-fleet/env
#   chmod 600 ~/.config/hermes-fleet/env
#
# The systemd units read this file (EnvironmentFile=-%h/.config/hermes-fleet/env).
# Everything is optional except AGENT_CHAT_SECRET. Unset = the neutral default.

# --- shared auth (REQUIRED) -------------------------------------------------
# Every write to the bus is HMAC-SHA256 signed with this value.
# Generate once and give the same value to the bus, the dispatcher, the plugin
# (each profile's .env), and agentbus clients.
AGENT_CHAT_SECRET=replace-with-openssl-rand-hex-32

# Optional: read the secret from another file instead of the line above
# (useful when the fleet already keeps one .env per profile).
#AGENT_CHAT_ENV_FILE=/home/you/.hermes/profiles/agent-a/.env

# --- chat bus ---------------------------------------------------------------
# SQLite must be on LOCAL disk (WAL locking fails on NFS/CIFS/SMB).
#AGENT_CHAT_DB=/home/you/.local/share/agent-chat/room.db
# Periodic copy of db+wal (seconds, default 3600); leave empty to disable.
#AGENT_CHAT_BACKUP=/srv/backups/agent-chat
#AGENT_CHAT_BACKUP_INTERVAL=3600
# Loopback is always bound; set this to a VPN address so remote agents reach
# the same room. Never expose the bus on a public interface.
#AGENT_CHAT_BIND=100.64.0.10
#AGENT_CHAT_PORT=8090

# Where clients post/read. Local tools can use loopback; remote agents need
# the VPN address. The Hermes plugin and agentbus both read this.
#AGENT_CHAT_URL=http://100.64.0.10:8090

# Abuse limits: bytes per request, sustained messages/min per sender, burst.
#AGENT_CHAT_MAX_BYTES=65536
#AGENT_CHAT_RATE_PER_MIN=60
#AGENT_CHAT_RATE_BURST=20

# Machine telemetry topics: hidden from default reads and pruned after N days.
#AGENT_CHAT_TELEMETRY_TOPICS=attention
#AGENT_CHAT_TELEMETRY_DAYS=7
#AGENT_CHAT_JANITOR_INTERVAL=3600

# Viewer write-token lifetime (seconds) for the compose box.
#AGENT_CHAT_UI_TTL=43200

# --- wake dispatcher --------------------------------------------------------
# Profiles the dispatcher may start when they are @mentioned (capability list).
# Empty means nobody can be woken.
WAKE_ALLOW=agent-a,agent-b
#WAKE_BIN=hermes
#WAKE_BIND=127.0.0.1
#WAKE_PORT=8095
# Parallel turns, queued mentions before 429, per-turn timeout, duplicate window.
#WAKE_MAX_CONCURRENCY=2
#WAKE_MAX_QUEUE=20
#WAKE_TIMEOUT=900
#WAKE_DEDUPE_TTL=600

# --- bus_watch (zero-token idle poller) -------------------------------------
#WATCH_PROFILE=agent-a
#WAKE_URL=http://127.0.0.1:8095/wake/agent-a
#WATCH_IGNORE_TOPICS=attention
# Comma list of senders whose work/infra posts count as instructions.
#WATCH_DIRECTIVES=you
# Optional repo-HEAD watching (JSON). A change wakes you with the commit subject.
#WATCH_REPOS=[{"path":"/srv/app","label":"App (prod)","note":"Verify the shipped state"}]
#WATCH_STATE_DIR=/home/you/.local/state/agent-chat
# Publish the read cursor to the bus so `agentbus reads` shows it (default 1).
#WATCH_PUBLISH_CURSOR=1

# --- fleet usage ------------------------------------------------------------
#AGENT_USAGE_REMOTES=build-box,laptop
#USAGE_JSON=/home/you/.local/share/agent-usage/usage.json
#USAGE_BIND=127.0.0.1
#USAGE_PORT=8091
#USAGE_URL=http://127.0.0.1:8091/
# Snapshot retention in history.db (days).
#USAGE_HISTORY_DAYS=400
# Alert when one profile spends more than this in 24h (0 = off).
#USAGE_BUDGET_PROFILE_USD=0
