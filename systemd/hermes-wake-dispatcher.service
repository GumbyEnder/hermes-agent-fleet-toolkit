[Unit]
Description=Agent Chat Room wake dispatcher
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 %h/Agents/Projects/hermes-agent-fleet-toolkit/chat-room/wake_dispatcher.py
EnvironmentFile=-%h/.config/hermes-fleet/env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
