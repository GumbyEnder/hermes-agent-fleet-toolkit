[Unit]
Description=Hermes Fleet Token Usage viewer
After=network-online.target

[Service]
EnvironmentFile=-%h/.config/hermes-fleet/env
ExecStart=/usr/bin/python3 %h/Agents/Projects/hermes-agent-fleet-toolkit/fleet-usage/usage_viewer.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
