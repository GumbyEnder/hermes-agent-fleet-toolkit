[Unit]
Description=Collect fleet token usage snapshot

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/hermes-fleet/env
ExecStart=/usr/bin/python3 %h/Agents/Projects/hermes-agent-fleet-toolkit/fleet-usage/token_collector.py
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
