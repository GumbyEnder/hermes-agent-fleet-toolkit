[Unit]
Description=Hermes Agent Chat Bus (self-hosted; loopback + optional VPN bind)
After=network-online.target
Wants=network-online.target
# Rate limit belongs in [Unit], not [Service]. Measured 2026-11-13 on systemd 255:
# StartLimitIntervalSec in [Service] is dropped with "Unknown key name ... ignoring"
# and the 10s default silently applies instead of the intended 60s.
# StartLimitBurst in [Service] IS still honoured (probe: Burst=17 applied, Interval ignored),
# so only the interval moves. Do not "tidy" the burst back into [Unit] without re-probing.
StartLimitIntervalSec=60

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=90
EnvironmentFile=-%h/.config/hermes-fleet/env
ExecStart=/usr/bin/python3 %h/Agents/Projects/hermes-agent-fleet-toolkit/chat-room/bus.py
Restart=on-failure
RestartSec=3
StartLimitBurst=5
NoNewPrivileges=yes
# PrivateTmp=yes removed 2026-11-12 21:35:31 (backup: hermes-agent-chat-bus.service.bak-20261112T213523)
# on the theory that sqlite's WAL work failed inside the unit's private /tmp namespace.
# THAT THEORY IS DEAD (2026-11-13): the option has been off ever since and the class continued —
# 410 `disk I/O error` journal lines on 11-12, 76 on 11-13, `systemctl --user show -p PrivateTmp` = no.
# CAUSE UNKNOWN. The external hermes-agent-chat-walcheck timer is a MITIGATION, not a fix, and the
# reproduced mechanism is a `-wal` unlinked while it still holds frames (bus.py:82). Do not reinstate
# the namespace story as an explanation, and do not read this removal as having fixed anything.
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
